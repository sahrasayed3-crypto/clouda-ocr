{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clouda.local/schemas/teacher-page-analysis-v1.schema.json",
  "title": "Clouda teacher page analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page_id", "source_document_id", "page_type", "primary_language",
    "secondary_languages", "is_born_digital", "is_scanned", "quality_score",
    "orientation", "deskew_needed", "layout_type", "column_count",
    "reading_order", "main_text_regions", "margin_regions", "footnote_regions",
    "header_regions", "footer_regions", "page_number_regions",
    "illustration_regions", "table_regions", "uncertain_regions",
    "has_small_marginalia", "has_footnotes", "has_mixed_language",
    "recommended_teacher_roles", "analysis_confidence", "warnings"
  ],
  "properties": {
    "page_id": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "page_type": {"type": "string", "minLength": 1},
    "primary_language": {"type": "string", "minLength": 1},
    "secondary_languages": {"type": "array", "items": {"type": "string"}},
    "is_born_digital": {"type": "boolean"},
    "is_scanned": {"type": "boolean"},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "orientation": {"enum": [0, 90, 180, 270]},
    "deskew_needed": {"type": "boolean"},
    "layout_type": {"type": "string", "minLength": 1},
    "column_count": {"type": "integer", "minimum": 0},
    "reading_order": {"type": "array", "items": {"type": "string"}},
    "main_text_regions": {"$ref": "#/$defs/regions"},
    "margin_regions": {"$ref": "#/$defs/regions"},
    "footnote_regions": {"$ref": "#/$defs/regions"},
    "header_regions": {"$ref": "#/$defs/regions"},
    "footer_regions": {"$ref": "#/$defs/regions"},
    "page_number_regions": {"$ref": "#/$defs/regions"},
    "illustration_regions": {"$ref": "#/$defs/regions"},
    "table_regions": {"$ref": "#/$defs/regions"},
    "uncertain_regions": {"$ref": "#/$defs/regions"},
    "has_small_marginalia": {"type": "boolean"},
    "has_footnotes": {"type": "boolean"},
    "has_mixed_language": {"type": "boolean"},
    "recommended_teacher_roles": {"type": "array", "items": {"type": "string"}},
    "analysis_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "region_type", "coordinates", "reading_order", "confidence"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "region_type": {"type": "string", "minLength": 1},
          "coordinates": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "integer", "minimum": 0}
          },
          "reading_order": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
