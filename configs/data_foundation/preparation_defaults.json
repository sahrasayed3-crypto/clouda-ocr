{
  "_schema_version": "clouda.pretraining.config.v1",
  "allowed_image_extensions": [".jpeg", ".jpg", ".png", ".tif", ".tiff", ".webp"],
  "allowed_record_extensions": [".csv", ".json", ".jsonl", ".tsv"],
  "allowed_text_extensions": [".txt"],
  "text_without_image_policy": "exclude",
  "normalization": {
    "unicode_form": "NFC",
    "strip_bom": true,
    "normalize_line_endings": true,
    "preserve_line_breaks": true,
    "collapse_whitespace": false,
    "remove_zero_width": false,
    "remove_control_characters": false,
    "remove_tatweel": false,
    "remove_diacritics": false,
    "fold_alef": false,
    "fold_ya": false,
    "fold_digits": false,
    "presentation_forms": "preserve"
  },
  "split_seed": 20260722,
  "split_ratios": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.05,
    "holdout": 0.05
  },
  "holdout_enabled": true,
  "min_width": 8,
  "min_height": 8,
  "max_pixels": 100000000,
  "max_text_chars": 100000,
  "require_text": true,
  "require_image": true,
  "hash_cache_enabled": true,
  "workers": 1,
  "exporter": "jsonl",
  "include_holdout_in_export": false,
  "include_duplicates_in_export": false,
  "include_raw_text_in_export": false
}
