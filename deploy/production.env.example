# Placeholder-only production configuration template.
# Do not put real secrets in this file. Production values must come from the
# protected host environment, Secret Manager, or attached runtime identity.

CLOUDA_ENV=production
AUTH_MODE=firebase_staging
CLOUDA_FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
CLOUDA_PRODUCTION_FIREBASE_PROJECT_ALLOWLIST=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_PROJECT_ID=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_API_KEY=REPLACE_WITH_PUBLIC_FIREBASE_WEB_CONFIG_VALUE
FIREBASE_CLIENT_AUTH_DOMAIN=REPLACE_WITH_PRODUCTION_AUTH_DOMAIN
FIREBASE_AUTH_EMULATOR_HOST=
CLOUDA_USE_ATTACHED_IDENTITY=true
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

CLOUDA_ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_HOSTS
CLOUDA_ALLOWED_ORIGINS=REPLACE_WITH_HTTPS_FRONTEND_ORIGIN
CLOUDA_TRUSTED_PROXY_CIDRS=REPLACE_WITH_TRUSTED_PROXY_CIDRS
CLOUDA_SESSION_COOKIE_SECURE=true
CLOUDA_SESSION_LIFETIME_SECONDS=3600
CLOUDA_SESSION_IDLE_SECONDS=900
CLOUDA_GUEST_SESSION_SECONDS=1800
CLOUDA_GUEST_JOB_TTL_SECONDS=1800

CLOUDA_DATABASE_PATH=REPLACE_WITH_ABSOLUTE_DATABASE_PATH
STORAGE_ROOT=REPLACE_WITH_ABSOLUTE_STORAGE_ROOT
TEMP_ROOT=REPLACE_WITH_ABSOLUTE_TEMP_ROOT
CLOUDA_BACKUP_ROOT=REPLACE_WITH_ABSOLUTE_BACKUP_ROOT
CLOUDA_BACKUP_RPO_MINUTES=REPLACE_WITH_APPROVED_RPO_MINUTES
CLOUDA_BACKUP_RTO_MINUTES=REPLACE_WITH_APPROVED_RTO_MINUTES
CLOUDA_MONITORING_CONFIGURED=false
CLOUDA_ALERT_ROUTING_CONFIGURED=false
CLOUDA_AUDIT_RETENTION_DAYS=REPLACE_WITH_APPROVED_AUDIT_RETENTION_DAYS

REDIS_URL=rediss://REPLACE_WITH_PRIVATE_REDIS_HOST:6379/0
CLOUDA_REDIS_NAMESPACE=REPLACE_WITH_UNIQUE_PRODUCTION_NAMESPACE
CLOUDA_REDIS_TLS_REQUIRED=true
CLOUDA_REDIS_CERT_REQS=required
RQ_QUEUE_NAME=REPLACE_WITH_PRODUCTION_QUEUE_NAME
WORKER_API_KEY=REPLACE_WITH_SECRET_MANAGER_WORKER_KEY
CLOUDA_WORKER_API_KEY_PREVIOUS=
CLOUDA_PROCESSING_STALE_SECONDS=900
CLOUDA_FINALIZING_STALE_SECONDS=300
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=7200
JOB_RETRY_COUNT=2

CLOUDA_MAX_REQUEST_BYTES=115343360
CLOUDA_MAX_UPLOAD_BYTES=104857600
CLOUDA_MAX_RESULT_BYTES=104857600
CLOUDA_MAX_PDF_BYTES=104857600
CLOUDA_MAX_PDF_PAGES=500
CLOUDA_GUEST_MAX_BYTES=10485760
CLOUDA_GUEST_MAX_PAGES=5
CLOUDA_USER_UPLOADS_PER_MINUTE=12
CLOUDA_ADMIN_ACTIONS_PER_MINUTE=30

CLOUDA_DEBUG=false
CLOUDA_ALLOW_LIVE_FIREBASE_TESTS=0
LOCAL_PROCESSING_ENABLED=false
CLOUDA_LOCAL_OCR_ENABLED=false
KEY_ROUTER_MODE=disabled
TEACHER_PIPELINE_MODE=disabled
