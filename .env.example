# Copy this file to .env for local development.
# Do not commit .env or real secrets.

# All defaults resolve outside the tracked repository. Override these with
# absolute paths appropriate for the host.
CLOUDA_RUNTIME_ROOT=
CLOUDA_DATASET_ROOT=
CLOUDA_ARTIFACT_ROOT=
CLOUDA_MODEL_ROOT=
CLOUDA_CACHE_ROOT=
CLOUDA_DATABASE_PATH=
CLOUDA_DATASET_MANIFEST_DATABASE_PATH=
CLOUDA_LOCAL_OCR_ENABLED=false
CLOUDA_MAX_UPLOAD_BYTES=104857600
CLOUDA_MAX_RESULT_BYTES=104857600
CLOUDA_MAX_PDF_BYTES=104857600
CLOUDA_MAX_PDF_PAGES=500
CLOUDA_MAX_IMAGE_PIXELS=40000000
CLOUDA_MAX_ARCHIVE_MEMBERS=10000
CLOUDA_MAX_DECOMPRESSED_BYTES=1073741824
CLOUDA_ALLOWED_HOSTS=127.0.0.1,localhost
CLOUDA_USER_DOCUMENT_TRAINING_CONSENT=false
# Optional only during a controlled worker-key rotation; remove after cutover.
CLOUDA_WORKER_API_KEY_PREVIOUS=

# Multi-user authentication. AUTH_MODE is preferred; legacy
# CLOUDA_AUTH_VERIFIER remains supported for compatibility.
AUTH_MODE=local
CLOUDA_ENV=development
CLOUDA_AUTH_VERIFIER=fake
CLOUDA_FIREBASE_PROJECT_ID=local-test-project
CLOUDA_REQUIRE_VERIFIED_EMAIL=true
CLOUDA_SESSION_COOKIE_SECURE=false
CLOUDA_SESSION_LIFETIME_SECONDS=3600
CLOUDA_SESSION_IDLE_SECONDS=900
CLOUDA_FIRST_ADMIN_BOOTSTRAP_TOKEN=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_PROJECT_ID=local-test-project
FIREBASE_CLIENT_API_KEY=placeholder-public-web-api-key
FIREBASE_CLIENT_AUTH_DOMAIN=localhost
FIREBASE_CLIENT_PROJECT_ID=local-test-project
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
CLOUDA_ALLOW_LIVE_FIREBASE_TESTS=0
CLOUDA_STAGING_FIREBASE_PROJECT_ALLOWLIST=
CLOUDA_FIREBASE_SMOKE_EMAIL=
CLOUDA_FIREBASE_SMOKE_PASSWORD=

# Guest OCR trial. Defaults are free/local-only and intentionally conservative.
CLOUDA_GUEST_SESSION_SECONDS=1800
CLOUDA_GUEST_JOB_TTL_SECONDS=1800
CLOUDA_GUEST_MAX_BYTES=10485760
CLOUDA_GUEST_MAX_PAGES=5
CLOUDA_GUEST_CAPTCHA_PROVIDER=fake
CLOUDA_GUEST_DAILY_BUDGET=25
CLOUDA_GUEST_UPLOADS_PER_MINUTE=6
CLOUDA_USER_UPLOADS_PER_MINUTE=12
CLOUDA_ADMIN_ACTIONS_PER_MINUTE=30

APP_ROLE=server
LOCAL_PROCESSING_ENABLED=false
SERVER_BASE_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
CLOUDA_REDIS_NAMESPACE=clouda-local
CLOUDA_REDIS_TLS_REQUIRED=false
CLOUDA_REDIS_CERT_REQS=required
CLOUDA_REDIS_HEALTH_INTERVAL=30
CLOUDA_INTERNAL_RATE_LIMIT_PER_MINUTE=1000
RQ_QUEUE_NAME=pdf_conversion
WORKER_API_KEY=
WORKER_NAME=clouda-local
WORKER_CONCURRENCY=1

# Local OCR remains disabled unless every required setting is explicit.
CLOUDA_LOCAL_OCR_ENGINE=none
CLOUDA_LOCAL_OCR_MODEL_PATH=
CLOUDA_LOCAL_OCR_PROCESSOR_PATH=
CLOUDA_LOCAL_OCR_DEVICE=cpu
CLOUDA_LOCAL_OCR_DTYPE=float32
CLOUDA_LOCAL_OCR_MAX_IMAGE_PIXELS=40000000
CLOUDA_LOCAL_OCR_MAX_NEW_TOKENS=2048
CLOUDA_LOCAL_OCR_TIMEOUT_SECONDS=120
CLOUDA_LOCAL_OCR_BATCH_SIZE=1
CLOUDA_LOCAL_OCR_ENDPOINT=http://127.0.0.1:8001/v1
CLOUDA_LOCAL_OCR_TASK=markdown

DATABASE_PATH=data/clouda.sqlite3
STORAGE_ROOT=conversions
TEMP_ROOT=conversions/temporary
JOB_TIMEOUT_SECONDS=7200
JOB_RETRY_COUNT=2

# Optional cloud/provider variables for future non-default integrations.
# No OCR model is selected or claimed as supported yet.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Dormant Key Router / Provider Account Router foundation.
# Keep disabled unless account records and environment-held secrets are explicitly configured.
KEY_ROUTER_MODE=disabled
KEY_ROUTER_ID=clouda-local
KEY_ROUTER_FREE_ONLY_DEFAULT=true
KEY_ROUTER_ALLOW_PAID_DEFAULT=false
KEY_ROUTER_REQUIRE_VERIFIED_VISION=true
KEY_ROUTER_ALLOW_DECLARED_ONLY_CAPABILITIES=false
KEY_ROUTER_MAX_ATTEMPTS=3
KEY_ROUTER_MAX_PROVIDER_FAILOVERS=1
KEY_ROUTER_MAX_ACCOUNT_FAILOVERS=1
KEY_ROUTER_TOTAL_TIMEOUT_SECONDS=180
KEY_ROUTER_DEFAULT_COOLDOWN_SECONDS=60
KEY_ROUTER_CIRCUIT_FAILURE_THRESHOLD=3
KEY_ROUTER_CIRCUIT_OPEN_SECONDS=60
KEY_ROUTER_CIRCUIT_FAILURE_WINDOW_SECONDS=60
KEY_ROUTER_HALF_OPEN_PROBE_COUNT=1
KEY_ROUTER_RESERVATION_TTL_SECONDS=300
KEY_ROUTER_UNCERTAIN_TTL_SECONDS=1800
KEY_ROUTER_UNCERTAIN_RECONCILIATION_SECONDS=1800
KEY_ROUTER_DEFAULT_DAILY_COST_LIMIT=0
KEY_ROUTER_LIVE_TESTS_ENABLED=false

# Phase 3 teacher orchestration is local, dormant, and fail-closed.
# Setting TRAINING_ENABLED=true does NOT enable training; execution is
# disabled structurally (dry_run=True + TrainingExecutionDisabled guard).
TEACHER_PIPELINE_MODE=disabled
TEACHER_LIVE_DISPATCH_ALLOWED=false
TRAINING_ENABLED=false
CLOUD_UPLOAD_ENABLED=false
TEACHER_ACCEPTANCE_POLICY_VERSION=teacher-acceptance-v1
TEACHER_CHARACTER_AGREEMENT_MIN=0.97
TEACHER_WORD_AGREEMENT_MIN=0.95
TEACHER_LINE_DISAGREEMENT_MAX=0.02
TEACHER_CONFIDENCE_MIN=0.85
TEACHER_JUDGE_CONFIDENCE_MIN=0.90
TEACHER_SOURCE_IMAGE_COVERAGE_MIN=0.98
TEACHER_UNCERTAIN_SPAN_RATIO_MAX=0.01

# Provider accounts store these non-secret references, never raw values.
NVIDIA_ACCOUNT_A_SECRET_REF=env:NVIDIA_API_KEY_A
NVIDIA_ACCOUNT_B_SECRET_REF=env:NVIDIA_API_KEY_B
OPENROUTER_PRIMARY_SECRET_REF=env:OPENROUTER_API_KEY_PRIMARY
OPENROUTER_API_KEY_PRIMARY=
NVIDIA_API_KEY_A=
NVIDIA_API_KEY_B=
GOOGLE_AI_STUDIO_API_KEY_PRIMARY=
GOOGLE_PERSON_01_API_KEY=
GOOGLE_PERSON_02_API_KEY=
GOOGLE_PERSON_03_API_KEY=
GOOGLE_PERSON_04_API_KEY=
GOOGLE_PERSON_05_API_KEY=
GOOGLE_PERSON_06_API_KEY=
GOOGLE_PERSON_07_API_KEY=
GOOGLE_PERSON_08_API_KEY=
GOOGLE_PERSON_09_API_KEY=
GOOGLE_PERSON_10_API_KEY=
ALIBABA_DASHSCOPE_API_KEY_PRIMARY=
REQUESTY_API_KEY_PRIMARY=
HUGGINGFACE_API_KEY_PRIMARY=
NVIDIA_NIM_API_KEY_PRIMARY=
SAMBANOVA_API_KEY_PRIMARY=
GITHUB_MODELS_TOKEN_PRIMARY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN_PRIMARY=
SILICONFLOW_API_KEY_PRIMARY=
DEEPINFRA_API_KEY_PRIMARY=
FIREWORKS_API_KEY_PRIMARY=
TOGETHER_API_KEY_PRIMARY=
NEBIUS_API_KEY_PRIMARY=
REPLICATE_API_TOKEN_PRIMARY=
NOVITA_API_KEY_PRIMARY=
